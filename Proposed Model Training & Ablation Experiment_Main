history = {
    'train_loss': [], 'val_loss': [],
    'train_acc': [],  'val_acc': [],
    'train_f1': [],   'val_f1': [],
    'val_precision': [], 'val_recall': []
}

df = pd.read_csv(FINAL_CLEAN_CSV)
